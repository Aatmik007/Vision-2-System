# Vision2System Backend Environment Variables
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vision2system
JWT_SECRET=vision2system_super_secret_production_key_2026

# Google Gemini API Key (Backend only, never exposed to client)
